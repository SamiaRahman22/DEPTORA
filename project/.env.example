# Used by docker-compose.yml for variable substitution (${SECRET_KEY}, ${CORS_ORIGINS}).
# Copy this file to ".env" in this same folder before running docker-compose up.

SECRET_KEY=replace-with-a-long-random-string

# Comma-separated list of origins the frontend will actually be served from.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
